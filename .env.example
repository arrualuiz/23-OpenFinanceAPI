# Pluggy
# Crie uma aplicacao no dashboard da Pluggy e cole as chaves aqui.
PLUGGY_CLIENT_ID=seu_pluggy_client_id
PLUGGY_CLIENT_SECRET=seu_pluggy_client_secret

# Servidor local
PORT=3333
CLIENT_USER_ID=seu_user_id

# Google Sheets opcional.
# Use uma service account do Google Cloud e compartilhe a planilha com o email dela.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Nome das abas que o script vai atualizar/criar.
SHEET_SUMMARY_TAB=ResumoAutomatizado
SHEET_RAW_TAB=DadosPluggy

